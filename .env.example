# Copy to .env. You need at least one brain: GEMINI_API_KEY (cloud) and/or the local Qwen model
# (scripts/install_local.sh). With both, switch any time: the Gemini | Qwen toggle in the window (Alt+B), or say
# "switch to Qwen" / "switch to Gemini".
GEMINI_API_KEY=

# Which brain starts: auto = the one you used last, or gemini / qwen to pin it
BRAIN=auto

# ---- Qwen brain (runs on this PC: private, works offline) ----
LOCAL_MODEL=qwen3.8:27b
# Context window: smaller = faster and lighter
LOCAL_CTX=6144
# CPU threads for the part of the model that doesn't fit on the GPU (0 = automatic; try 6-10 if replies are slow)
LOCAL_THREADS=0
# GPU layers for Qwen: auto (from the VRAM left after speech loads) or a fixed number such as 20
LOCAL_GPU_LAYERS=auto
# Minutes Qwen stays in memory after you switch away (fast to switch back); then the GPU is freed
LOCAL_KEEP_WARM_MIN=10
# Speech for the Qwen brain: large-v3-turbo (best, GPU) or small.en (lighter)
WHISPER_MODEL=large-v3-turbo
WHISPER_COMPUTE=int8_float16
WHISPER_LANGUAGE=en
# British male voices: bm_george, bm_lewis, bm_daniel, bm_fable - or a blend like bm_george:0.6,bm_lewis:0.4
LOCAL_VOICE=bm_george
LOCAL_VOICE_SPEED=1.0

# ---- Gemini brain (cloud) ----

# Voice model (run ./run.sh --list-models to see what your key can use)
GEMINI_MODEL=gemini-3.8-live
# Deep male voices: Algieba (smooth), Charon (informative), Alnilam (firm), Gacrux (mature), Puck
GEMINI_VOICE=Algieba
# Text models for ask_gemini (deep thinking), tried in order when one is busy
GEMINI_BRAIN_MODELS=gemini-3.8-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-flash-lite-latest
USER_NAME=Aniket

# bypassPermissions = Claude may do anything without asking (Jarvis still asks YOU before installs/deletes)
# acceptEdits       = safer: Claude can edit files but risky shell commands are refused
CLAUDE_PERMISSION_MODE=bypassPermissions
CLAUDE_TIMEOUT_MIN=45
# Model per task complexity (Gemini rates each delegated task basic / medium / high)
JARVIS_CLAUDE_MODEL_BASIC=claude-haiku-5-5
JARVIS_CLAUDE_MODEL_COMPLEX=claude-sonnet-5-5
JARVIS_CLAUDE_EFFORT=low
# CLAUDE_BIN=/path/to/claude      (only if it can't be found automatically)
DEFAULT_WORKDIR=~
PROJECTS_DIR=~/Documents/Aniket

# Audio. By default Jarvis follows your system's output: headphones/headset connected -> it speaks through them AND
# listens through their own mic; otherwise your default speaker and a real PC/USB mic. It switches live when you
# connect or disconnect headphones.
# off = keep listening with the PC mic and only play through the headphones (Bluetooth headsets drop to
# phone-call sound quality while their mic is in use, which also affects music you play at the same time)
PREFER_HEADSET_MIC=on
# Force a device instead (index or part of the name, see ./run.sh --devices):
# MIC_DEVICE=
# SPEAKER_DEVICE=
# auto = mute the mic while Jarvis talks unless you use a Bluetooth headset's own mic (it cancels echo); on / off to force
ECHO_GUARD=auto
# on = only send audio to Gemini while you are speaking above the room noise (stops it reacting to noise)
NOISE_GATE=on
# How long a pause (ms) ends your turn. Lower = snappier, higher = fewer cut-off sentences
VAD_SILENCE_MS=700

# OpenCode coding agent on the local Qwen model (provider "ollama" in ~/.config/opencode/opencode.json)
# OPENCODE_MODEL=ollama/qwen3.8-oc   (qwen3.8:27b with a 16k context: ollama create qwen3.8-oc; also the voice brain LOCAL_MODEL)
# Chrome extension bridge port (extension: ./chrome_extension, load it at chrome://extensions)
# BRIDGE_PORT=8765
# Memory: 0 (default) = no fixed cap, tidies itself; a number sets a hard cap in MB
# MEMORY_MAX_MB=0
# Stop the Ollama server when Qwen/OpenCode are idle (default on); minutes to keep Qwen after switching away
# STOP_OLLAMA_WHEN_IDLE=on
# LOCAL_KEEP_WARM_MIN=2
# Jarvis decides when you've finished speaking (pauses mid-thought are not the end); off = fixed VAD_SILENCE_MS
# SMART_TURNS=on
