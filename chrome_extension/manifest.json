{
  "manifest_version": 3,
  "name": "Jarvis Hands",
  "version": "3.3.0",
  "description": "Lets the Jarvis voice assistant on this PC control Chrome: tabs, clicks, typing, forms, video, reading pages.",
  "key": "",
  "permissions": [
    "activeTab",
    "alarms",
    "bookmarks",
    "debugger",
    "history",
    "scripting",
    "sessions",
    "storage",
    "tabGroups",
    "tabs",
    "webNavigation",
    "windows"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Jarvis Hands",
    "default_popup": "popup.html"
  },
  "minimum_chrome_version": "116"
}